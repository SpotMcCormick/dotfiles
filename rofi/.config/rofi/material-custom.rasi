* {
    bg:       #1a1b26F2;
    bg-alt:   #292e42;
    bg-sel:   #7aa2f7;
    fg:       #c0caf5;
    fg-dim:   #565f89;
    fg-sel:   #1a1b26;
    accent:   #7aa2f7;
    border:   #414868;

    spacing: 0;
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 640px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 8px;
    padding: 10px;
}

inputbar {
    children: [prompt, entry];
    padding: 4px 8px;
    background-color: transparent;
}

prompt {
    str: ">";
    text-color: @accent;
    margin: 0 8px 0 0;
}

entry {
    text-color: @fg;
    placeholder: "";
    placeholder-color: @fg-dim;
}

listview {
    lines: 12;
    scrollbar: false;
    fixed-height: true;
}

element {
    padding: 6px 8px;
    spacing: 10px;
    border-radius: 6px;
    children: [element-icon, element-text];
}

element selected {
    background-color: @bg-sel;
}

element-icon {
    size: 1.4em;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @fg-sel;
}
